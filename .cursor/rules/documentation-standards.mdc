### 复杂业务逻辑注释
```tsx
/**
 * 计算合同总金额
 * 
 * 根据服务项目列表计算合同的总金额，包含以下计算规则：
 * 1. 基础服务费：固定收费项目的总和
 * 2. 按量计费：根据数量计算的服务费用
 * 3. 折扣计算：VIP客户享受不同折扣
 * 4. 税费计算：根据税率计算增值税
 */
const calculateContractAmount = (
  serviceItems: ServiceItem[],
  customer: Customer,
  taxRate: number = 0.06
): ContractAmount => {
  // 1. 计算基础服务费
  const baseServiceFee = serviceItems
    .filter(item => item.chargeType === 'FIXED')
    .reduce((sum, item) => sum + item.price, 0);

  // 2. 计算按量服务费
  const volumeServiceFee = serviceItems
    .filter(item => item.chargeType === 'VOLUME')
    .reduce((sum, item) => sum + (item.price * item.quantity), 0);

  // 3. 应用客户折扣
  const subtotal = baseServiceFee + volumeServiceFee;
  const discount = getCustomerDiscount(customer.level);
  const discountedAmount = subtotal * (1 - discount);

  // 4. 计算税费
  const taxAmount = discountedAmount * taxRate;
  const totalAmount = discountedAmount + taxAmount;

  return {
    baseServiceFee,
    volumeServiceFee,
    subtotal,
    discount,
    discountedAmount,
    taxAmount,
    totalAmount,
  };
};
```

## 类型定义注释

### 接口和类型注释
```tsx
/**
 * 客户信息接口
 * 
 * 定义系统中客户的完整信息结构
 */
interface Customer {
  /** 客户唯一标识 */
  id: number;
  
  /** 公司名称 */
  companyName: string;
  
  /** 统一社会信用代码 */
  unifiedSocialCreditCode: string;
  
  /** 
   * 企业类型
   * @example "有限责任公司" | "股份有限公司" | "个人独资企业"
   */
  enterpriseType: string;
  
  /** 
   * 客户等级
   * - VIP: VIP客户，享受最高优先级服务
   * - PREMIUM: 高级客户，享受优先服务
   * - STANDARD: 标准客户，常规服务
   * - BASIC: 基础客户，基本服务
   */
  level: 'VIP' | 'PREMIUM' | 'STANDARD' | 'BASIC';
  
  /** 
   * 客户状态
   * - ACTIVE: 活跃状态，可正常提供服务
   * - INACTIVE: 停用状态，暂停服务
   * - PENDING: 待审核状态，等待审核通过
   */
  status: 'ACTIVE' | 'INACTIVE' | 'PENDING';
  
  /** 联系人信息 */
  contact: {
    /** 联系人姓名 */
    person: string;
    /** 联系电话 */
    phone: string;
    /** 电子邮箱 */
    email?: string;
    /** 办公地址 */
    address?: string;
  };
  
  /** 创建时间 */
  createdAt: string;
  
  /** 最后更新时间 */
  updatedAt: string;
}
```

## API 文档注释

### API 接口注释
```tsx
/**
 * 客户管理 API
 * 
 * 提供客户信息的增删改查功能
 */
export class CustomerAPI {
  /**
   * 获取客户列表
   * 
   * @param params - 查询参数
   * @param params.page - 页码，从1开始
   * @param params.pageSize - 每页数量，默认10条
   * @param params.keyword - 搜索关键词，支持公司名称和统一社会信用代码
   * @param params.status - 客户状态筛选
   * @param params.level - 客户等级筛选
   * @param params.enterpriseType - 企业类型筛选
   * 
   * @returns Promise<ApiResponse<PaginatedResponse<Customer>>> 分页的客户列表
   * 
   * @throws {ValidationError} 当查询参数验证失败时
   * @throws {NetworkError} 当网络请求失败时
   * 
   * @example
   * ```tsx
   * // 获取第一页数据
   * const response = await CustomerAPI.getList({ page: 1, pageSize: 10 });
   * 
   * // 搜索特定客户
   * const response = await CustomerAPI.getList({
   *   page: 1,
   *   pageSize: 10,
   *   keyword: '测试公司',
   *   status: 'ACTIVE'
   * });
   * ```
   */
  static async getList(params: GetCustomerListParams): Promise<ApiResponse<PaginatedResponse<Customer>>> {
    return api.get('/customers', params);
  }
}
```

## 中文注释规范

项目中所有注释都应使用中文，包括：

1. **业务逻辑注释** - 使用中文解释业务规则和处理逻辑
2. **变量和函数说明** - 使用中文描述变量用途和函数功能
3. **TODO 和 FIXME** - 使用中文说明待办事项和需要修复的问题
4. **代码块注释** - 使用中文解释复杂代码段的作用

```tsx
// ✅ 好的中文注释示例
/**
 * 计算客户的折扣率
 * 根据客户等级和历史消费金额确定折扣比例
 */
const getCustomerDiscount = (customer: Customer): number => {
  // VIP客户享受最高折扣
  if (customer.level === 'VIP') {
    return 0.15; // 15% 折扣
  }
  
  // 高级客户根据消费金额计算折扣
  if (customer.level === 'PREMIUM') {
    // 消费超过10万的给予10%折扣，否则给予5%折扣
    return customer.totalSpent > 100000 ? 0.10 : 0.05;
  }
  
  // 普通客户不享受折扣
  return 0;
};

