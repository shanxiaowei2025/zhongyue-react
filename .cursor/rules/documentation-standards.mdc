# 文档和注释标准

## 代码注释规范

### TypeScript/JavaScript 注释标准

#### 函数和方法注释
```tsx
/**
 * 创建客户信息
 * @param customerData - 客户数据对象
 * @param options - 可选配置项
 * @returns Promise<Customer> 返回创建的客户信息
 * @throws {ValidationError} 当客户数据验证失败时抛出
 * @example
 * ```tsx
 * const customer = await createCustomer({
 *   companyName: '测试公司',
 *   unifiedSocialCreditCode: '91110000000000000X'
 * });
 * ```
 */
export const createCustomer = async (
  customerData: CreateCustomerRequest,
  options?: CreateOptions
): Promise<Customer> => {
  // 验证必填字段
  if (!customerData.companyName) {
    throw new ValidationError('公司名称不能为空');
  }

  // 检查统一社会信用代码格式
  if (!isValidCreditCode(customerData.unifiedSocialCreditCode)) {
    throw new ValidationError('统一社会信用代码格式不正确');
  }

  try {
    const response = await api.post('/customers', customerData);
    return response.data;
  } catch (error) {
    // 处理创建失败的情况
    console.error('创建客户失败:', error);
    throw error;
  }
};
```

